# Local configuration: publish examples only.
hub.config.json
/projects/*
!/projects/_example/
/projects/_example/*
!/projects/_example/hub.config.json.example

# Runtime indexes, logs, caches and test output contain local paths/content.
scan.json
favorites.json
favorites.json.tmp
*.log
*.log.*
*.pid
node_modules/
coverage/
.cache/
.playwright-mcp/
playwright-report/
test-results/
artifacts/
temp/
tmp/

# Credentials and machine-specific agent/editor configuration.
.env
.env.*
!.env.example
!.env.sample
*.key
*.pem
*.pfx
*.p12
*.ppk
credentials*.json
secrets*.json
.mcp.json
.claude/settings.local.json
.codex/config.toml
.vscode/
.idea/
*.code-workspace

# Private original design exports and screenshots (retained locally).
/src/*
!/src/README.md
/images/*
!/images/README.md
!/images/Public/
/images/Public/*
!/images/Public/README.md
!/images/Public/project-hub-header.svg
!/images/Public/project-overview.png
!/images/Public/document-reader.png
/Zip/
*.zip
*.bak
*.tmp
*~

# OS metadata
Thumbs.db
desktop.ini
.DS_Store

# Demo site: the fixture under demo/ is published on purpose, so the general rules above
# (agent configs, local hub configs) must not swallow it. The build output is generated.
/demo/.build/
/demo/site/
!/demo/**/.mcp.json
!/demo/**/.codex/config.toml

# Machine-specific runbooks (tailnet names, device IPs).
/docs/Local/

# Local Claude Code scratch (screenshots, notes) - never published.
.claude/temp/

# Archify build receipts and screenshots (scripts/build-diagram.mjs)
docs/diagrams/.build/
