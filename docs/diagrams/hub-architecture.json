  "cards": [
    {
      "dot": "rose",
      "title": "What the server refuses",
      "items": [
        "Any Host header other than loopback or a listed allowedHosts name gets a 403, which stops DNS rebinding",
        "resolveId() admits only paths under a mounted root, never a secrets folder or a key or certificate file, and follows a symlink or junction to judge where it really points",
        "/api/open, raw and preview files, repo diffs, the link check, favorites and webmarks are same-origin only; mounting a root also needs a loopback Host"
      ]
    },
    {
      "dot": "cyan",
      "title": "How the tree stays fresh",
      "items": [
        "A worker thread walks the tree and runs git per repo, then hands back the payload, gzipped once and served to every tab",
        "A repo's git status is reused until its git files or its working tree change, so a watcher rescan skips most of git",
        "After a burst it waits out a 30 s gap from the last scan, rescans first, then sends one change event, so no tab fetches a stale copy"
      ]
    },
    {
      "dot": "violet",
      "title": "Built only when asked",
      "items": [
        "Pictures loads one folder at a time, and search inside documents builds its index on the first query that needs it, never during a scan",
        "A repo's changed files and one file's diff, and a folder's link check, run only when their page asks",
        "HTML reports open through signed directory routes with a sandbox on every response"
      ]
    },
    {
      "dot": "amber",
      "title": "Outside the process",
      "items": [
        "Watch-Hubs.ps1 runs every 15 minutes and restarts an unhealthy hub through Start-Hub.ps1",
        "The demo build runs the real hub against demo/Workspace and captures every API response as a file",
        "The hosted demo has no server, so launching files, searching inside documents and the link check are unavailable there"
      ]
    }
  ]
