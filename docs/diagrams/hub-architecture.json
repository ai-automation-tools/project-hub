  "cards": [
    {
      "dot": "rose",
      "title": "What the server refuses",
      "items": [
        "Any Host header other than loopback or a listed allowedHosts name gets a 403, which stops DNS rebinding",
        "resolveId() admits only paths under a mounted root, and never a secrets folder or a key or certificate file",
        "/api/open, favorites and webmarks are same-origin only; mounting a root also needs a loopback Host"
      ]
    },
    {
      "dot": "cyan",
      "title": "How the tree stays fresh",
      "items": [
        "One synchronous walk plus git per repo builds the payload, gzipped once and served to every tab",
        "The watcher drops build output, git internals, the hub's own logs and bare directory events",
        "After a settled burst it rescans first, then sends one change event, so no tab fetches a stale copy"
      ]
    },
    {
      "dot": "violet",
      "title": "Built only when asked",
      "items": [
        "Pictures loads one folder at a time; its search index is built on the first query that needs it",
        "Search inside documents builds its index on the first such query, never during a scan",
        "HTML reports open through signed directory routes with a sandbox on every response"
      ]
    },
    {
      "dot": "amber",
      "title": "Outside the process",
      "items": [
        "Watch-Hubs.ps1 runs every 15 minutes and restarts an unhealthy hub through Start-Hub.ps1",
        "The demo build runs the real hub against Demo/Workspace and captures every API response as a file",
        "The hosted demo has no server, so launching files and searching inside documents are unavailable there"
      ]
    }
  ]
